// Prisma Schema cho My_Task_App (PostgreSQL local và production)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String?
  name              String
  avatar            String?            @default("lucide:User")
  avatarBg          String?            @default("#BBF7D0")
  googleId          String?            @unique
  tasks             Task[]
  stickyNotes       StickyNote[]
  habits            Habit[]
  dailyMoods        DailyMood[]
  weeklyReflections WeeklyReflection[]
  journalEntries    JournalEntry[]
  tags              Tag[]
  deletedEntities   DeletedEntity[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Task {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  completed    Boolean   @default(false)
  dueDate      String?
  startDate    String?
  endDate      String?
  timeType     String?   @default("deadline") // "scheduled" | "deadline"
  startTime    String?
  endTime      String?
  deadlineDate String?
  deadlineTime String?
  tag          String?
  tags         String?
  priority     String?   @default("medium")
  status       String    @default("todo")
  parentTaskId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model DeletedEntity {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  deletedAt  DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId, deletedAt])
}

model StickyNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  color     String   @default("yellow")
  tilt      String   @default("none")
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Habit {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  frequency         String   @default("daily")
  targetDaysPerWeek Int?     @default(7)
  completedDates    String   @default("[]") // JSON string list of YYYY-MM-DD
  streak            Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DailyMood {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateStr   String // YYYY-MM-DD
  moodEmoji String // e.g. "lucide:Smile"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dateStr])
}

model WeeklyReflection {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model JournalEntry {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String    // YYYY-MM-DD
  time         String    @default("00:00") // HH:mm
  content      String
  linkedTaskId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, date])
}
